# Server Configuration
PORT=5001
NODE_ENV=development # e.g., development, test, production

# Database URL
# For Docker, use 'db' as the hostname. For local development, use 'localhost'.
DATABASE_URL="postgresql://user:password@db:5432/mydatabase?schema=public"

# PostgreSQL specific variables (if not using DATABASE_URL directly for connection)
POSTGRES_DB="mydatabase"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"

# JWT Configuration
JWT_SECRET="your-jwt-secret"
JWT_EXPIRES_IN=1d # e.g., 1d, 7d, 2h
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_SECRET="your-jwt-reset-password-secret"
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# Refresh Token Cookie
REFRESH_TOKEN_COOKIE_NAME="your-refresh-token-cookie-name"

# AWS S3 Configuration
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="your-aws-region"
AWS_S3_BUCKET="your-aws-s3-bucket-name"

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Redis Configuration for BullMQ
# For Docker, use 'redis' as the hostname. For local development, use 'localhost'.
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password # Uncomment and set if your Redis instance requires a password

# Client URL (for password reset links, etc.)
CLIENT_URL=http://localhost:3000

# Socket.IO CORS origin
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Email Configuration
EMAIL_PROVIDER=NODEMAILER # Options: NODEMAILER, SENDGRID
EMAIL_FROM=your-email@example.com

# Nodemailer (SMTP) Configuration (if EMAIL_PROVIDER is NODEMAILER)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# SendGrid Configuration (if EMAIL_PROVIDER is SENDGRID)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
