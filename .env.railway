# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=auto # Cloudflare R2 uses 'auto'
# For AWS S3
#AWS_ENDPOINT=https://s3.us-east-1.amazonaws.com

# For Cloudflare R2 (Free Alternative).
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_BUCKET=your_s3_bucket_name

# Redis Configuration for BullMQ
REDIS_URL=${{redis.REDIS_URL}}
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=${{redis.REDIS_PASSWORD}} # Uncomment and set if your Redis instance requires a password

